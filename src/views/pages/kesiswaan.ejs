<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Header Banner -->
<section class="bg-navy-950 text-white py-14 sm:py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-gold-500/20 text-gold-300 border border-gold-400/40 mb-3">
        <i class="fa-solid fa-trophy text-gold-400"></i> Kreativitas & Prestasi
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Kesiswaan & Ekstrakurikuler</h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
        Wadah pembinaan minat, bakat, kepemimpinan karakter, dan tradisi juara bagi seluruh siswa SMA Negeri 12 Denpasar.
      </p>
    </div>
  </div>
  <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>
</section>

<!-- Sub Navigation Tabs Sticky -->
<div class="bg-white border-b border-slate-200 sticky top-20 z-40 shadow-sm overflow-x-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-6 text-sm font-semibold text-slate-600">
    <a href="#ekskul" class="py-3.5 border-b-2 border-transparent hover:border-gold-500 hover:text-navy-900 transition whitespace-nowrap">Ekstrakurikuler</a>
    <a href="#osis" class="py-3.5 border-b-2 border-transparent hover:border-gold-500 hover:text-navy-900 transition whitespace-nowrap">OSIS & MPK</a>
    <a href="#prestasi" class="py-3.5 border-b-2 border-transparent hover:border-gold-500 hover:text-navy-900 transition whitespace-nowrap">Prestasi Siswa</a>
  </div>
</div>

<main class="py-12 bg-slate-50 space-y-16">
  
  <!-- 1. EKSTRAKURIKULER -->
  <section id="ekskul" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-36">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-bold text-gold-600 tracking-wider uppercase bg-gold-100 px-3 py-1 rounded-full">
        Pilihan Kegiatan
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 mt-2 tracking-tight">
        Ekstrakurikuler Unggulan
      </h2>
      <p class="text-xs text-slate-500 mt-1">Mengasah soft skills, sportivitas, dan pelestarian seni budaya Bali</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (extracurriculars && extracurriculars.length > 0) { %>
        <% extracurriculars.forEach(item => { %>
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col">
            <div class="h-48 bg-slate-100 relative overflow-hidden group">
              <img src="<%= item.photo || 'https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?w=800&auto=format&fit=crop&q=80' %>" alt="<%= item.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
              <span class="absolute top-3 left-3 bg-navy-900/90 text-gold-300 text-[11px] font-bold px-2.5 py-1 rounded-lg backdrop-blur-sm">
                <%= item.category %>
              </span>
            </div>
            
            <div class="p-6 flex flex-col flex-grow">
              <h3 class="font-bold text-navy-900 text-base mb-2">
                <%= item.name %>
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4 flex-grow">
                <%= item.description %>
              </p>

              <div class="pt-4 border-t border-slate-100 space-y-2 text-xs text-slate-500">
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-user-tie text-gold-500 w-4"></i>
                  <span>Pembina: <strong class="text-slate-700"><%= item.mentor || '-' %></strong></span>
                </div>
                <div class="flex items-center gap-2">
                  <i class="fa-regular fa-clock text-gold-500 w-4"></i>
                  <span>Jadwal: <%= item.schedule || '-' %></span>
                </div>
                <div class="flex items-center gap-2">
                  <i class="fa-solid fa-location-dot text-gold-500 w-4"></i>
                  <span>Tempat: <%= item.location || 'Area Sekolah' %></span>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </section>

  <!-- 2. OSIS & MPK -->
  <section id="osis" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-36">
    <div class="bg-gradient-to-br from-navy-900 to-navy-950 text-white rounded-3xl p-8 sm:p-12 shadow-xl border border-navy-800">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-bold text-gold-400 uppercase tracking-wider bg-gold-500/20 px-3 py-1 rounded-full border border-gold-400/30">
            Kepemimpinan Siswa
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            OSIS & Majelis Perwakilan Kelas (MPK)
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Organisasi Siswa Intra Sekolah (OSIS) SMA Negeri 12 Denpasar merupakan wadah utama partisipasi siswa dalam merancang program-program inspiratif, seperti Peringatan Hari Saraswati, Bulan Bahasa Bali, Smandas Art Fest, Aksi Lingkungan Adiwiyata, dan Bakti Sosial Masyarakat.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-center text-xs">
            <div class="p-3 bg-white/10 rounded-xl backdrop-blur-sm border border-white/10">
              <div class="text-lg font-bold text-gold-400">10 Sekbid</div>
              <div class="text-slate-300 text-[11px]">Seksi Bidang Aktif</div>
            </div>
            <div class="p-3 bg-white/10 rounded-xl backdrop-blur-sm border border-white/10">
              <div class="text-lg font-bold text-gold-400">100%</div>
              <div class="text-slate-300 text-[11px]">Musyawarah Terbuka</div>
            </div>
            <div class="p-3 bg-white/10 rounded-xl backdrop-blur-sm border border-white/10">
              <div class="text-lg font-bold text-gold-400">20+ Event</div>
              <div class="text-slate-300 text-[11px]">Program Kerja Tahunan</div>
            </div>
          </div>
        </div>
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden shadow-lg border-2 border-gold-400/30">
            <img src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=800&auto=format&fit=crop&q=80" alt="Pengurus OSIS" class="w-full h-72 object-cover">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PRESTASI SISWA -->
  <section id="prestasi" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-36">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-bold text-gold-600 tracking-wider uppercase bg-gold-100 px-3 py-1 rounded-full">
          Tradisi Juara
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 mt-2 tracking-tight">
          Daftar Prestasi & Apresiasi Siswa
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% if (achievements && achievements.length > 0) { %>
        <% achievements.forEach(ach => { %>
          <div class="bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-lg transition flex flex-col">
            <div class="h-44 bg-slate-100 relative overflow-hidden">
              <img src="<%= ach.photo || 'https://images.unsplash.com/photo-1546410531-bb4caa6b424d?w=600&auto=format&fit=crop&q=80' %>" alt="<%= ach.title %>" class="w-full h-full object-cover">
              <span class="absolute top-3 right-3 bg-gold-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg shadow">
                <%= ach.level %>
              </span>
            </div>
            
            <div class="p-5 flex flex-col flex-grow">
              <div class="flex items-center justify-between text-[11px] font-bold text-gold-600 mb-1.5">
                <span><%= ach.rank %></span>
                <span class="text-slate-400">Tahun <%= ach.year %></span>
              </div>
              <h3 class="font-bold text-navy-900 text-sm leading-snug mb-2">
                <%= ach.title %>
              </h3>
              <div class="text-xs text-slate-700 font-semibold mb-2 flex items-center gap-1.5">
                <i class="fa-solid fa-user-graduate text-navy-900"></i>
                <span><%= ach.student_name %></span>
              </div>
              <p class="text-xs text-slate-500 leading-relaxed line-clamp-3 mb-3 flex-grow">
                <%= ach.description %>
              </p>
              <% if (ach.organizer) { %>
                <div class="pt-3 border-t border-slate-100 text-[11px] text-slate-400 italic">
                  Penyelenggara: <%= ach.organizer %>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-3 text-center py-12 text-slate-400 text-sm">
          Belum ada data prestasi yang dicatat.
        </div>
      <% } %>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>
