<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Header Banner -->
<section class="bg-navy-950 text-white py-14 sm:py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-gold-500/20 text-gold-300 border border-gold-400/40 mb-3">
        <i class="fa-solid fa-graduation-cap text-gold-400"></i> Pendidikan Berkualitas
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Akademik & Kurikulum</h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
        Implementasi Kurikulum Merdeka yang berfokus pada pengembangan bakat, karakter Profil Pelajar Pancasila, dan kesiapan melanjutkan ke perguruan tinggi unggulan.
      </p>
    </div>
  </div>
  <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>
</section>

<main class="py-12 bg-slate-50 space-y-16">
  
  <!-- 1. KURIKULUM MERDEKA OVERVIEW -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-slate-200/80">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <span class="text-xs font-bold text-gold-600 uppercase tracking-wider bg-gold-50 px-3 py-1 rounded-full">
            Landasan Pembelajaran
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 tracking-tight">
            Penerapan Kurikulum Merdeka Mandiri Berbagi
          </h2>
          <p class="text-sm text-slate-600 leading-relaxed">
            SMA Negeri 12 Denpasar menerapkan Kurikulum Merdeka secara menyeluruh. Pembelajaran dirancang secara kontekstual, berdiferensiasi, dan berbasis proyek (Project-Based Learning) untuk menjawab keunikan potensi setiap peserta didik.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <h4 class="font-bold text-navy-900 text-sm mb-1">Fase E (Kelas X)</h4>
              <p class="text-xs text-slate-500">Masa eksplorasi seluruh mata pelajaran umum, pemetaan minat bakat, dan pembiasaan dasar riset serta proyek P5.</p>
            </div>
            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200">
              <h4 class="font-bold text-navy-900 text-sm mb-1">Fase F (Kelas XI & XII)</h4>
              <p class="text-xs text-slate-500">Masa spesialisasi di mana siswa memilih mata pelajaran pilihan sesuai cita-cita karir dan jurusan perguruan tinggi.</p>
            </div>
          </div>
        </div>
        <div class="lg:col-span-4 bg-navy-900 text-white rounded-2xl p-6 text-center shadow-lg border border-gold-400/30">
          <div class="w-16 h-16 rounded-2xl bg-gold-500/20 text-gold-400 flex items-center justify-center text-3xl mx-auto mb-4">
            <i class="fa-solid fa-shapes"></i>
          </div>
          <h3 class="font-bold text-base text-gold-300">Proyek P5</h3>
          <p class="text-xs text-slate-300 mt-2 leading-relaxed">
            Penguatan Profil Pelajar Pancasila: Gaya Hidup Berkelanjutan, Kearifan Lokal Bali, Rekayasa Teknologi, Kewirausahaan, dan Bangunlah Jiwa Raganya.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. PEMINATAN & KELOMPOK MATA PELAJARAN -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <span class="text-xs font-bold text-gold-600 tracking-wider uppercase bg-gold-100 px-3 py-1 rounded-full">
        Paket Peminatan
      </span>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 mt-2 tracking-tight">
        Mata Pelajaran Pilihan Fase F
      </h2>
      <p class="text-xs text-slate-500 mt-1">Fleksibilitas memilih kombinasi mata pelajaran yang relevan dengan masa depan siswa</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Sains & Teknologi -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-gold-400 transition">
        <div>
          <div class="w-12 h-12 rounded-xl bg-navy-50 text-navy-900 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-flask-vial"></i>
          </div>
          <h3 class="font-bold text-navy-900 text-base mb-2">Sains & Rekayasa Teknologi</h3>
          <p class="text-xs text-slate-500 mb-4 leading-relaxed">
            Dirancang bagi siswa yang bercita-cita melanjutkan studi ke Kedokteran, Teknik, Informatika, Farmasi, dan Sains Alam.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 font-medium border-t border-slate-100 pt-3">
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Matematika Tingkat Lanjut</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Fisika</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Kimia</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Biologi & Genetika</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Informatika & Coding</li>
          </ul>
        </div>
      </div>

      <!-- Sosial & Humaniora -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-gold-400 transition">
        <div>
          <div class="w-12 h-12 rounded-xl bg-gold-50 text-gold-600 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-scale-balanced"></i>
          </div>
          <h3 class="font-bold text-navy-900 text-base mb-2">Sosial & Humaniora</h3>
          <p class="text-xs text-slate-500 mb-4 leading-relaxed">
            Menyiapkan calon sarjana di bidang Hukum, Hubungan Internasional, Manajemen Bisnis, Akuntansi, Psikologi, dan Ilmu Komunikasi.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 font-medium border-t border-slate-100 pt-3">
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Ekonomi & Akuntansi</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Sosiologi & Antropologi</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Geografi Analitis</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Sejarah Tingkat Lanjut</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Riset Sosial Lapangan</li>
          </ul>
        </div>
      </div>

      <!-- Bahasa, Budaya & Seni -->
      <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col justify-between hover:border-gold-400 transition">
        <div>
          <div class="w-12 h-12 rounded-xl bg-navy-50 text-navy-900 flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-language"></i>
          </div>
          <h3 class="font-bold text-navy-900 text-base mb-2">Bahasa, Budaya & Pariwisata</h3>
          <p class="text-xs text-slate-500 mb-4 leading-relaxed">
            Mewadahi kompetensi pariwisata berbudaya, diplomasi global, sastra bahasa asing, seni pertunjukan, dan komunikasi media.
          </p>
          <ul class="space-y-2 text-xs text-slate-700 font-medium border-t border-slate-100 pt-3">
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Bahasa Inggris Lanjut (IELTS Prep)</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Bahasa & Aksara Bali</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Bahasa Asing Pilihan (Jepang)</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Seni Budaya Tradisi & Digital</li>
            <li class="flex items-center gap-2"><i class="fa-solid fa-check text-gold-500 text-[10px]"></i> Industri Kreatif Pariwisata</li>
          </ul>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. KALENDER AKADEMIK & JADWAL -->
  <section id="jadwal" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-36">
    <div class="bg-white rounded-3xl p-8 sm:p-12 shadow-sm border border-slate-200/80">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
          <span class="text-xs font-bold text-gold-600 uppercase tracking-wider bg-gold-50 px-3 py-1 rounded-full">
            Waktu Pembelajaran
          </span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 mt-2 tracking-tight">
            Jadwal Harian & Kalender Pendidikan
          </h2>
        </div>
        <a href="/unduhan?kategori=Kalender Pendidikan" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-navy-900 text-white font-semibold text-xs hover:bg-navy-800 transition">
          <i class="fa-solid fa-download"></i> Unduh Kalender Pendidikan PDF
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        <!-- Jam Tatap Muka -->
        <div class="space-y-4">
          <h4 class="font-bold text-navy-900 text-sm flex items-center gap-2">
            <i class="fa-regular fa-clock text-gold-500"></i> Jam Belajar Mengajar (WITA)
          </h4>
          <div class="divide-y divide-slate-100 text-xs">
            <div class="py-2.5 flex justify-between">
              <span class="font-semibold text-slate-700">Senin</span>
              <span class="text-slate-500">07.00 - 15.30 (Upacara Bendera & KBM)</span>
            </div>
            <div class="py-2.5 flex justify-between">
              <span class="font-semibold text-slate-700">Selasa - Kamis</span>
              <span class="text-slate-500">07.30 - 15.30 (Literasi Pagi & KBM)</span>
            </div>
            <div class="py-2.5 flex justify-between">
              <span class="font-semibold text-slate-700">Jumat</span>
              <span class="text-slate-500">07.00 - 12.00 (Krida/Senam/Persembahyangan & KBM)</span>
            </div>
            <div class="py-2.5 flex justify-between">
              <span class="font-semibold text-slate-700">Sabtu & Minggu</span>
              <span class="text-emerald-600 font-semibold">Libur Akhir Pekan (Ekskul Tertentu)</span>
            </div>
          </div>
        </div>

        <!-- Agenda Akademik Utama -->
        <div class="space-y-4">
          <h4 class="font-bold text-navy-900 text-sm flex items-center gap-2">
            <i class="fa-solid fa-calendar-check text-gold-500"></i> Agenda Akademik Semester Berjalan
          </h4>
          <div class="space-y-2.5 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex justify-between items-center">
              <div>
                <div class="font-bold text-navy-900">Penilaian Sumatif Tengah Semester (STS)</div>
                <div class="text-[11px] text-slate-500">Evaluasi perkembangan capaian kompetensi</div>
              </div>
              <span class="font-semibold text-gold-700 bg-gold-100 px-2 py-1 rounded">Oktober 2026</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex justify-between items-center">
              <div>
                <div class="font-bold text-navy-900">Penilaian Akhir Semester (PAS) Ganjil</div>
                <div class="text-[11px] text-slate-500">Ujian berbasis CBT komputer daring</div>
              </div>
              <span class="font-semibold text-navy-900 bg-navy-100 px-2 py-1 rounded">Desember 2026</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 flex justify-between items-center">
              <div>
                <div class="font-bold text-navy-900">Pembagian Rapor Semester Ganjil</div>
                <div class="text-[11px] text-slate-500">Penyampaian hasil belajar kepada orang tua</div>
              </div>
              <span class="font-semibold text-emerald-700 bg-emerald-100 px-2 py-1 rounded">18 Des 2026</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</main>

<%- include('../partials/footer') %>
