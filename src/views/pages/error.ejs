<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-grow flex items-center justify-center py-20 px-4">
  <div class="max-w-md w-full text-center">
    <div class="w-24 h-24 mx-auto mb-6 rounded-2xl bg-gold-100 text-gold-600 flex items-center justify-center text-5xl font-black shadow-inner">
      <%= typeof status !== 'undefined' ? status : '404' %>
    </div>
    <h1 class="text-2xl font-extrabold text-navy-900 mb-2">
      <%= typeof title !== 'undefined' ? title : 'Halaman Tidak Ditemukan' %>
    </h1>
    <p class="text-sm text-slate-600 mb-8 leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'Maaf, tautan yang Anda tuju tidak tersedia atau telah dipindahkan ke alamat baru.' %>
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl bg-navy-900 hover:bg-navy-800 text-white font-semibold text-sm shadow transition">
        <i class="fa-solid fa-house"></i> Kembali ke Beranda
      </a>
      <a href="/kontak" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-xl border border-slate-300 hover:bg-slate-100 text-slate-700 font-semibold text-sm transition">
        <i class="fa-solid fa-envelope"></i> Hubungi Sekolah
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
