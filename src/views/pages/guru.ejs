<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<!-- Header Banner -->
<section class="bg-navy-950 text-white py-14 sm:py-20 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-gold-500/20 text-gold-300 border border-gold-400/40 mb-3">
        <i class="fa-solid fa-users text-gold-400"></i> Sumber Daya Manusia
      </span>
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight">Guru & Tenaga Kependidikan</h1>
      <p class="text-sm sm:text-base text-slate-300 mt-3 leading-relaxed">
        Pendidik profesional bersertifikasi, berdedikasi tinggi, dan staf kependidikan yang siap melayani dengan hati untuk kemajuan putra-putri bangsa.
      </p>
    </div>
  </div>
  <div class="absolute -right-10 -bottom-10 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>
</section>

<!-- Filter Navigation -->
<div class="bg-white border-b border-slate-200 sticky top-20 z-40 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center gap-4">
    <div class="flex items-center space-x-2 text-xs sm:text-sm font-semibold">
      <a href="/guru?role=all" class="px-4 py-2 rounded-xl transition <%= activeRole === 'all' ? 'bg-navy-900 text-white shadow' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>">
        Semua (<%= teachers.length %>)
      </a>
      <a href="/guru?role=guru" class="px-4 py-2 rounded-xl transition <%= activeRole === 'guru' ? 'bg-navy-900 text-white shadow' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>">
        Guru Mapel
      </a>
      <a href="/guru?role=staff" class="px-4 py-2 rounded-xl transition <%= activeRole === 'staff' ? 'bg-navy-900 text-white shadow' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' %>">
        Tata Usaha & Staf
      </a>
    </div>

    <!-- Quick Search on page -->
    <div class="relative w-full sm:w-64">
      <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
      <input type="text" id="teacherSearch" placeholder="Cari nama guru / mapel..." class="w-full pl-9 pr-4 py-2 text-xs bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 focus:bg-white transition">
    </div>
  </div>
</div>

<main class="py-12 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div id="teachersGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <% if (teachers && teachers.length > 0) { %>
        <% teachers.forEach(t => { %>
          <div class="teacher-card bg-white rounded-2xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition duration-300 flex flex-col" data-name="<%= (t.name + ' ' + (t.subject || '') + ' ' + (t.position || '')).toLowerCase() %>">
            
            <!-- Foto Guru -->
            <div class="h-64 bg-slate-100 relative overflow-hidden group">
              <img src="<%= t.photo || '/images/default-teacher.png' %>" alt="<%= t.name %>" class="w-full h-full object-cover object-top group-hover:scale-105 transition duration-500" loading="lazy">
              <% if (t.role_type === 'kepala_sekolah') { %>
                <span class="absolute top-3 left-3 bg-gold-500 text-white text-[11px] font-bold px-2.5 py-1 rounded-lg shadow">
                  Kepala Sekolah
                </span>
              <% } else if (t.position && t.position.includes('Wakasek')) { %>
                <span class="absolute top-3 left-3 bg-navy-900 text-gold-300 text-[11px] font-bold px-2.5 py-1 rounded-lg shadow">
                  Wakasek
                </span>
              <% } %>
            </div>

            <!-- Detail Guru -->
            <div class="p-5 flex flex-col flex-grow text-center">
              <h3 class="font-bold text-navy-900 text-sm leading-snug mb-1">
                <%= t.name %>
              </h3>
              
              <div class="text-xs font-semibold text-gold-600 mb-2">
                <%= t.position || 'Guru Mata Pelajaran' %>
              </div>

              <% if (t.subject && t.subject !== '-') { %>
                <div class="text-[11px] text-slate-600 bg-slate-50 border border-slate-100 py-1 px-2.5 rounded-lg mb-2">
                  <i class="fa-solid fa-book-open text-gold-500 mr-1"></i> <%= t.subject %>
                </div>
              <% } %>

              <% if (t.nip) { %>
                <div class="text-[10px] text-slate-400 font-mono mb-2">
                  NIP. <%= t.nip %>
                </div>
              <% } %>

              <% if (t.education) { %>
                <div class="text-[11px] text-slate-500 mt-auto pt-2 border-t border-slate-100 italic line-clamp-1">
                  <i class="fa-solid fa-graduation-cap text-slate-400 mr-1"></i> <%= t.education %>
                </div>
              <% } %>
            </div>

          </div>
        <% }) %>
      <% } else { %>
        <div class="col-span-4 text-center py-16 text-slate-400 text-sm">
          Tidak ada data guru atau tenaga kependidikan yang sesuai dengan filter.
        </div>
      <% } %>
    </div>

  </div>
</main>

<script>
  // Live filter pencarian guru
  const searchInput = document.getElementById('teacherSearch');
  const cards = document.querySelectorAll('.teacher-card');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase().trim();
      cards.forEach(card => {
        const data = card.getAttribute('data-name');
        if (data.includes(q)) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  }
</script>

<%- include('../partials/footer') %>
