<!-- Topbar Informasi & Kontak -->
<div class="bg-navy-950 text-slate-300 text-xs border-b border-navy-800 hidden md:block">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex justify-between items-center">
    <div class="flex items-center space-x-6">
      <span class="flex items-center gap-2">
        <i class="fa-solid fa-location-dot text-gold-400"></i>
        <span><%= school.address || 'Jl. Trengguli No. 12, Denpasar Timur, Bali' %></span>
      </span>
      <span class="flex items-center gap-2">
        <i class="fa-solid fa-phone text-gold-400"></i>
        <span><%= school.phone || '(0361) 462912' %></span>
      </span>
      <span class="flex items-center gap-2">
        <i class="fa-solid fa-envelope text-gold-400"></i>
        <span><%= school.email || 'info@sman12denpasar.sch.id' %></span>
      </span>
    </div>
    <div class="flex items-center space-x-4">
      <% if (school.instagram) { %>
        <a href="<%= school.instagram %>" target="_blank" rel="noopener" class="hover:text-gold-400 transition" title="Instagram"><i class="fa-brands fa-instagram text-sm"></i></a>
      <% } %>
      <% if (school.facebook) { %>
        <a href="<%= school.facebook %>" target="_blank" rel="noopener" class="hover:text-gold-400 transition" title="Facebook"><i class="fa-brands fa-facebook text-sm"></i></a>
      <% } %>
      <% if (school.youtube) { %>
        <a href="<%= school.youtube %>" target="_blank" rel="noopener" class="hover:text-gold-400 transition" title="YouTube"><i class="fa-brands fa-youtube text-sm"></i></a>
      <% } %>
      <% if (school.whatsapp) { %>
        <a href="https://wa.me/<%= (school.whatsapp || '').replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener" class="hover:text-gold-400 transition" title="WhatsApp"><i class="fa-brands fa-whatsapp text-sm"></i></a>
      <% } %>
      <span class="text-navy-700">|</span>
      <% if (user) { %>
        <a href="/admin/dashboard" class="flex items-center gap-1.5 bg-navy-800 hover:bg-navy-700 text-gold-400 font-semibold px-2.5 py-1 rounded transition">
          <i class="fa-solid fa-gauge-high"></i> Panel Admin (<%= user.name.split(' ')[0] %>)
        </a>
      <% } else { %>
        <a href="/auth/login" class="flex items-center gap-1.5 hover:text-white transition font-medium">
          <i class="fa-solid fa-lock text-gold-400"></i> Login Admin
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl shadow-[0_4px_24px_-12px_rgba(11,37,69,0.25)] border-b border-slate-200/70 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo & Nama Sekolah -->
      <a href="/" class="flex items-center gap-3.5 group min-w-0">
        <div class="w-12 h-12 flex items-center justify-center flex-shrink-0 group-hover:scale-105 transition-transform duration-300 drop-shadow-sm">
          <% if (school.logo_url) { %>
            <img src="<%= school.logo_url %>" alt="Logo <%= school.school_name %>" class="w-full h-full object-contain">
          <% } else { %>
            <div class="w-full h-full rounded-xl bg-navy-900 flex items-center justify-center text-gold-400">
              <i class="fa-solid fa-graduation-cap text-xl"></i>
            </div>
          <% } %>
        </div>
        <div class="flex flex-col justify-center min-w-0">
          <span class="block text-base sm:text-lg lg:text-[19px] font-extrabold text-navy-900 tracking-tight leading-none group-hover:text-navy-700 transition">
            <%= school.school_name || 'SMA Negeri 12 Denpasar' %>
          </span>
          <div class="flex items-center gap-1.5 text-[11px] text-slate-500 font-medium leading-none mt-1.5">
            <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 font-semibold text-[10px] tracking-wide border border-slate-200">
              NPSN <%= school.school_npsn || '69992012' %>
            </span>
            <span class="text-slate-300">&bull;</span>
            <span class="text-slate-500 font-semibold tracking-wide text-[10px] uppercase">Denpasar - Bali</span>
          </div>
        </div>
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center space-x-0.5 font-semibold text-slate-700">
        <!-- Beranda -->
        <a href="/" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath === '/' ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Beranda
        </a>

        <!-- Profil Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/profil') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
            <span>Profil</span>
            <i class="fa-solid fa-chevron-down text-xs text-slate-400 group-hover:rotate-180 transition-transform duration-200"></i>
          </button>
          <div class="absolute left-0 top-full pt-2 w-56 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white rounded-xl shadow-xl border border-slate-100 p-2 space-y-1">
              <a href="/profil#sejarah" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-landmark text-gold-500 w-4"></i> Sejarah Sekolah
              </a>
              <a href="/profil#visi-misi" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-bullseye text-gold-500 w-4"></i> Visi & Misi
              </a>
              <a href="/profil#sambutan" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-user-tie text-gold-500 w-4"></i> Sambutan Kepala Sekolah
              </a>
              <a href="/profil#sarpras" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-building-columns text-gold-500 w-4"></i> Sarana & Prasarana
              </a>
              <a href="/profil#akreditasi" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-certificate text-gold-500 w-4"></i> Akreditasi Sekolah
              </a>
            </div>
          </div>
        </div>

        <!-- Akademik -->
        <a href="/akademik" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/akademik') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Akademik
        </a>

        <!-- Guru & Staf -->
        <a href="/guru" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/guru') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Guru & Staf
        </a>

        <!-- Kesiswaan Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1.5 px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/kesiswaan') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
            <span>Kesiswaan</span>
            <i class="fa-solid fa-chevron-down text-xs text-slate-400 group-hover:rotate-180 transition-transform duration-200"></i>
          </button>
          <div class="absolute left-0 top-full pt-2 w-56 opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-white rounded-xl shadow-xl border border-slate-100 p-2 space-y-1">
              <a href="/kesiswaan#ekskul" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-icons text-gold-500 w-4"></i> Ekstrakurikuler
              </a>
              <a href="/kesiswaan#prestasi" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-trophy text-gold-500 w-4"></i> Prestasi Siswa
              </a>
              <a href="/kesiswaan#osis" class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-slate-700 hover:bg-navy-50 hover:text-navy-900 transition">
                <i class="fa-solid fa-users text-gold-500 w-4"></i> Organisasi Siswa (OSIS)
              </a>
            </div>
          </div>
        </div>

        <!-- Berita & Pengumuman -->
        <a href="/berita" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/berita') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Berita
        </a>

        <!-- Galeri -->
        <a href="/galeri" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/galeri') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Galeri
        </a>

        <!-- Unduhan -->
        <a href="/unduhan" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/unduhan') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Unduhan
        </a>

        <!-- Kontak -->
        <a href="/kontak" class="px-3 py-2 rounded-full text-[13px] transition <%= currentPath.startsWith('/kontak') ? 'text-white font-bold bg-navy-900 shadow-sm' : 'text-slate-600 hover:text-navy-900 hover:bg-slate-100' %>">
          Kontak
        </a>
      </nav>

      <!-- CTA PPDB & Mobile Menu Button -->
      <div class="flex items-center gap-3">
        <a href="/ppdb" class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-white font-bold px-4 py-2.5 rounded-full shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 text-sm">
          <i class="fa-solid fa-user-plus"></i>
          <span>Info PPDB</span>
          <span class="inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] font-extrabold bg-white text-gold-700 rounded-full animate-pulse">2026</span>
        </a>

        <!-- Hamburger Button Mobile -->
        <button id="mobileMenuBtn" type="button" class="lg:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none" aria-label="Toggle menu">
          <i class="fa-solid fa-bars text-xl"></i>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobileMenu" class="hidden lg:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-6 space-y-1">
    <a href="/" class="block px-3 py-2.5 rounded-lg text-base font-semibold <%= currentPath === '/' ? 'text-navy-900 bg-navy-50' : 'text-slate-700' %>">
      <i class="fa-solid fa-house w-6 text-gold-500"></i> Beranda
    </a>
    <a href="/profil" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-school w-6 text-gold-500"></i> Profil Sekolah
    </a>
    <a href="/akademik" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-book-open w-6 text-gold-500"></i> Akademik & Kurikulum
    </a>
    <a href="/guru" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-chalkboard-user w-6 text-gold-500"></i> Guru & Tenaga Kependidikan
    </a>
    <a href="/kesiswaan" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-people-group w-6 text-gold-500"></i> Kesiswaan & Prestasi
    </a>
    <a href="/berita" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-newspaper w-6 text-gold-500"></i> Berita & Pengumuman
    </a>
    <a href="/galeri" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-images w-6 text-gold-500"></i> Galeri Foto & Video
    </a>
    <a href="/unduhan" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-cloud-arrow-down w-6 text-gold-500"></i> Unduhan Dokumen
    </a>
    <a href="/kontak" class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-700">
      <i class="fa-solid fa-address-book w-6 text-gold-500"></i> Kontak & Peta
    </a>
    <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
      <a href="/ppdb" class="w-full text-center py-2.5 rounded-xl bg-gold-500 text-white font-bold shadow-md">
        <i class="fa-solid fa-user-plus mr-1"></i> Informasi Pendaftaran PPDB
      </a>
      <% if (user) { %>
        <a href="/admin/dashboard" class="w-full text-center py-2 rounded-xl bg-navy-900 text-gold-400 font-semibold text-sm">
          <i class="fa-solid fa-gauge-high mr-1"></i> Dashboard Admin (<%= user.name %>)
        </a>
      <% } else { %>
        <a href="/auth/login" class="w-full text-center py-2 rounded-xl border border-slate-300 text-slate-700 font-medium text-sm">
          <i class="fa-solid fa-lock mr-1 text-gold-500"></i> Login Administrator
        </a>
      <% } %>
    </div>
  </div>
</header>

<script>
  // Script interaktivitas hamburger menu mobile
  const btn = document.getElementById('mobileMenuBtn');
  const menu = document.getElementById('mobileMenu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>

