<!-- Sidebar Admin -->
<aside id="adminSidebar" class="w-64 bg-navy-950 text-slate-300 flex flex-col flex-shrink-0 border-r border-navy-800 transition-all duration-300 z-30">
  
  <!-- Sidebar Header -->
  <div class="h-20 px-6 flex items-center justify-between border-b border-navy-800">
    <a href="/admin/dashboard" class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-white p-1 flex items-center justify-center ring-1 ring-gold-400/40 overflow-hidden flex-shrink-0">
        <% if (school.logo_url) { %>
          <img src="<%= school.logo_url %>" alt="Logo" class="w-full h-full object-contain">
        <% } else { %>
          <i class="fa-solid fa-graduation-cap text-navy-900 font-bold text-lg"></i>
        <% } %>
      </div>
      <div>
        <div class="text-xs font-black text-white tracking-tight leading-none"><%= school.school_alias || 'SMANDAS' %></div>
        <div class="text-[10px] text-gold-400 font-semibold tracking-wider uppercase mt-1">NPSN <%= school.school_npsn || '69992012' %> &bull; Admin Panel</div>
      </div>
    </a>
  </div>

  <!-- Sidebar Navigation Menu -->
  <div class="flex-grow overflow-y-auto px-4 py-5 space-y-6 text-xs">
    
    <div>
      <div class="px-3 mb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">Menu Utama</div>
      <div class="space-y-1">
        <a href="/admin/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath === '/admin/dashboard' || currentPath === '/admin' ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-gauge-high text-sm w-4"></i>
          <span>Dashboard</span>
        </a>
      </div>
    </div>

    <div>
      <div class="px-3 mb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">Publikasi & Konten</div>
      <div class="space-y-1">
        <a href="/admin/posts" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/posts') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-newspaper text-sm w-4"></i>
          <span>Berita & Pengumuman</span>
        </a>
        <a href="/admin/events" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/events') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-calendar-day text-sm w-4"></i>
          <span>Agenda Kegiatan</span>
        </a>
        <a href="/admin/gallery" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/gallery') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-images text-sm w-4"></i>
          <span>Galeri Foto & Video</span>
        </a>
        <a href="/admin/downloads" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/downloads') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-cloud-arrow-down text-sm w-4"></i>
          <span>Dokumen Unduhan</span>
        </a>
        <a href="/admin/sliders" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/sliders') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-sliders text-sm w-4"></i>
          <span>Slider Hero Beranda</span>
        </a>
      </div>
    </div>

    <div>
      <div class="px-3 mb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">Data Sekolah & Siswa</div>
      <div class="space-y-1">
        <a href="/admin/teachers" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/teachers') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-chalkboard-user text-sm w-4"></i>
          <span>Guru & Tenaga Kependidikan</span>
        </a>
        <a href="/admin/achievements" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/achievements') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-trophy text-sm w-4"></i>
          <span>Prestasi Siswa</span>
        </a>
        <a href="/admin/extracurriculars" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/extracurriculars') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-people-group text-sm w-4"></i>
          <span>Ekstrakurikuler</span>
        </a>
        <a href="/admin/messages" class="flex items-center justify-between px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/messages') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-envelope text-sm w-4"></i>
            <span>Pesan Masuk</span>
          </div>
        </a>
      </div>
    </div>

    <div>
      <div class="px-3 mb-2 text-[10px] font-bold uppercase tracking-wider text-slate-500">Konfigurasi Sistem</div>
      <div class="space-y-1">
        <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/settings') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <i class="fa-solid fa-gear text-sm w-4"></i>
          <span>Identitas Sekolah & PPDB</span>
        </a>
        <a href="/auth/security" class="flex items-center justify-between gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/auth/security') || currentPath.startsWith('/auth/change-password') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
          <span class="flex items-center gap-3">
            <i class="fa-solid fa-shield-halved text-sm w-4"></i>
            <span>Keamanan Akun</span>
          </span>
          <% if (user && user.twoFactorEnabled) { %>
            <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300">2FA</span>
          <% } %>
        </a>
        <% if (user && user.role === 'superadmin') { %>
          <a href="/admin/users" class="flex items-center gap-3 px-3 py-2.5 rounded-xl font-semibold transition <%= currentPath.startsWith('/admin/users') ? 'bg-gold-500 text-white shadow' : 'text-slate-300 hover:bg-navy-900 hover:text-white' %>">
            <i class="fa-solid fa-users-gear text-sm w-4"></i>
            <span>Manajemen Pengguna</span>
          </a>
        <% } %>
      </div>
    </div>

  </div>

  <!-- Sidebar Footer User Profile -->
  <div class="p-4 border-t border-navy-800 bg-navy-950/80">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <img src="<%= user.avatar || '/images/default-avatar.png' %>" alt="<%= user.name %>" class="w-8 h-8 rounded-full object-cover ring-1 ring-gold-400">
        <div>
          <div class="text-xs font-bold text-white truncate max-w-[100px]"><%= user.name %></div>
          <div class="text-[10px] text-gold-400 uppercase font-semibold"><%= user.role %></div>
        </div>
      </div>
      <a href="/auth/logout" class="p-2 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-navy-900 transition" title="Keluar / Logout">
        <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
      </a>
    </div>
  </div>

</aside>
