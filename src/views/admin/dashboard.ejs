<%- include('../partials/admin-header') %>
<%- include('../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../partials/admin-navbar') %>

  <!-- Main Content Scrollable Area -->
  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-8">
    
    <%- include('../partials/alerts') %>

    <!-- Welcome Banner -->
    <div class="relative rounded-3xl overflow-hidden bg-gradient-to-r from-navy-950 via-navy-900 to-navy-800 text-white p-6 sm:p-8 shadow-md border border-navy-800">
      <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-gold-500/20 text-gold-300 border border-gold-400/40 mb-2">
            <i class="fa-solid fa-shield-halved text-gold-400"></i> Akses <%= user.role === 'superadmin' ? 'Super Administrator' : 'Editor Humas' %>
          </span>
          <h1 class="text-xl sm:text-2xl font-black tracking-tight">Selamat Datang, <%= user.name %>!</h1>
          <p class="text-xs text-slate-300 mt-1 max-w-xl">
            Sistem manajemen konten resmi SMA Negeri 12 Denpasar siap digunakan. Kelola publikasi warta, data pengajar, prestasi, dan permohonan informasi publik secara terpadu.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a href="/admin/posts/create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs shadow transition">
            <i class="fa-solid fa-pen-to-square"></i> Tulis Berita
          </a>
          <a href="/admin/settings" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-xs border border-white/20 transition">
            <i class="fa-solid fa-gear"></i> Pengaturan
          </a>
        </div>
      </div>
    </div>

    <!-- Statistics Cards Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
      
      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-navy-50 text-navy-900 flex items-center justify-center text-lg mb-3">
          <i class="fa-solid fa-newspaper"></i>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-navy-900"><%= stats.posts %></div>
          <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Total Berita</div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-gold-50 text-gold-600 flex items-center justify-center text-lg mb-3">
          <i class="fa-solid fa-chalkboard-user"></i>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-navy-900"><%= stats.teachers %></div>
          <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Guru & Staf</div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-lg mb-3">
          <i class="fa-solid fa-trophy"></i>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-navy-900"><%= stats.achievements %></div>
          <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Prestasi Siswa</div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-lg mb-3">
          <i class="fa-solid fa-cloud-arrow-down"></i>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-navy-900"><%= stats.downloads %></div>
          <div class="text-[11px] font-semibold text-slate-500 mt-0.5">File Unduhan</div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-lg mb-3">
          <i class="fa-solid fa-images"></i>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-navy-900"><%= stats.galleries %></div>
          <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Item Galeri</div>
        </div>
      </div>

      <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex flex-col justify-between">
        <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-lg mb-3">
          <i class="fa-solid fa-envelope"></i>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-navy-900"><%= stats.unreadMessages %></div>
          <div class="text-[11px] font-semibold text-slate-500 mt-0.5">Pesan Belum Dibaca</div>
        </div>
      </div>

    </div>

    <!-- Dua Kolom Konten Terbaru -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Berita Terbaru (7 Kolom) -->
      <div class="lg:col-span-7 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
          <h3 class="font-extrabold text-navy-900 text-sm flex items-center gap-2">
            <i class="fa-solid fa-newspaper text-gold-500"></i> Publikasi Warta Terbaru
          </h3>
          <a href="/admin/posts" class="text-xs font-bold text-gold-600 hover:underline">Kelola Semua</a>
        </div>

        <div class="divide-y divide-slate-100">
          <% if (recentPosts && recentPosts.length > 0) { %>
            <% recentPosts.forEach(post => { %>
              <div class="py-3 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  <img src="<%= post.thumbnail %>" alt="<%= post.title %>" class="w-11 h-11 rounded-xl object-cover bg-slate-100 flex-shrink-0">
                  <div>
                    <h4 class="font-bold text-xs text-navy-900 line-clamp-1 hover:text-gold-600 transition">
                      <a href="/admin/posts/<%= post.id %>/edit"><%= post.title %></a>
                    </h4>
                    <div class="text-[11px] text-slate-400 mt-0.5">
                      <span class="text-gold-600 font-semibold"><%= post.category_name || 'Berita' %></span> &bull; <%= formatShortDate(post.published_at) %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-2">
                  <a href="/admin/posts/<%= post.id %>/edit" class="p-1.5 rounded-lg text-slate-400 hover:text-navy-900 hover:bg-slate-100 transition" title="Edit Berita">
                    <i class="fa-solid fa-pen-to-square text-xs"></i>
                  </a>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-8 text-xs text-slate-400">Belum ada berita yang ditulis.</div>
          <% } %>
        </div>
      </div>

      <!-- Pesan Masuk Terbaru (5 Kolom) -->
      <div class="lg:col-span-5 bg-white rounded-3xl p-6 border border-slate-200/80 shadow-sm">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
          <h3 class="font-extrabold text-navy-900 text-sm flex items-center gap-2">
            <i class="fa-solid fa-envelope text-gold-500"></i> Aspirasi & Buku Tamu Masuk
          </h3>
          <a href="/admin/messages" class="text-xs font-bold text-gold-600 hover:underline">Lihat Semua</a>
        </div>

        <div class="divide-y divide-slate-100 text-xs">
          <% if (recentMessages && recentMessages.length > 0) { %>
            <% recentMessages.forEach(msg => { %>
              <a href="/admin/messages/<%= msg.id %>" class="py-3 flex items-start gap-3 group block">
                <div class="w-8 h-8 rounded-full <%= msg.is_read ? 'bg-slate-100 text-slate-400' : 'bg-gold-100 text-gold-600' %> flex items-center justify-center text-xs flex-shrink-0 mt-0.5">
                  <i class="fa-solid fa-user"></i>
                </div>
                <div class="flex-grow space-y-0.5">
                  <div class="flex justify-between items-center">
                    <span class="font-bold text-navy-900 group-hover:text-gold-600 transition"><%= msg.name %></span>
                    <span class="text-[10px] text-slate-400"><%= formatShortDate(msg.created_at) %></span>
                  </div>
                  <div class="font-semibold text-slate-700 text-[11px] line-clamp-1"><%= msg.subject %></div>
                  <div class="text-slate-500 text-[11px] line-clamp-1"><%= msg.message %></div>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <div class="text-center py-8 text-xs text-slate-400">Belum ada pesan masuk.</div>
          <% } %>
        </div>
      </div>

    </div>

  </main>
</div>

<%- include('../partials/admin-footer') %>
