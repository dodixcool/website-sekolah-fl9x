<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Tambah Agenda Kegiatan Baru</h1>
        <p class="text-xs text-slate-500 mt-0.5">Jadwalkan kegiatan sekolah yang akan tampil di kalender beranda</p>
      </div>
      <a href="/admin/events" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold hover:bg-slate-50 transition">
        <i class="fa-solid fa-arrow-left"></i> Kembali
      </a>
    </div>

    <div class="max-w-2xl bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <form action="/admin/events" method="POST" class="space-y-4 text-xs">
        <div>
          <label for="title" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Nama Agenda / Acara <span class="text-rose-500">*</span></label>
          <input type="text" id="title" name="title" required placeholder="Contoh: Peringatan Hari Suci Saraswati 2026" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="start_date" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Tanggal Mulai <span class="text-rose-500">*</span></label>
            <input type="date" id="start_date" name="start_date" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
          <div>
            <label for="end_date" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Tanggal Selesai (Opsional)</label>
            <input type="date" id="end_date" name="end_date" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="time_info" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Waktu / Pukul</label>
            <input type="text" id="time_info" name="time_info" placeholder="Contoh: 08.00 - 13.00 WITA" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
          <div>
            <label for="location" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Tempat / Lokasi</label>
            <input type="text" id="location" name="location" value="SMA Negeri 12 Denpasar" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div>
          <label for="organizer" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Penyelenggara / Panitia</label>
          <input type="text" id="organizer" name="organizer" placeholder="Contoh: OSIS / Tim Kurikulum" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
        </div>

        <div>
          <label for="description" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Keterangan Singkat Agenda</label>
          <textarea id="description" name="description" rows="3" placeholder="Deskripsi atau catatan kegiatan..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs"></textarea>
        </div>

        <div class="pt-3">
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider shadow transition">
            <i class="fa-solid fa-plus mr-1"></i> Simpan Agenda
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../../partials/admin-footer') %>
