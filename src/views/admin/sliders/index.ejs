<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <%- include('../../partials/alerts') %>

    <div>
      <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Manajemen Slider Banner Beranda</h1>
      <p class="text-xs text-slate-500 mt-0.5">Kelola foto latar, judul sambutan, dan tombol aksi (CTA) yang tampil pada carousel utama beranda</p>
    </div>

    <!-- Form Tambah Slider Baru -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <h3 class="font-bold text-navy-900 text-sm mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
        <i class="fa-solid fa-plus text-gold-500"></i> Tambah Banner Slider Baru
      </h3>

      <form action="/admin/sliders" method="POST" enctype="multipart/form-data" class="space-y-4 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="title" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Judul Utama Banner <span class="text-rose-500">*</span></label>
            <input type="text" id="title" name="title" required placeholder="Contoh: Selamat Datang di SMA Negeri 12 Denpasar" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
          </div>
          <div>
            <label for="subtitle" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Sub-Judul / Keterangan</label>
            <input type="text" id="subtitle" name="subtitle" placeholder="Deskripsi 1-2 baris yang memperjelas banner..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Unggah Gambar Latar (Resolusi min. 1600x900px)</label>
            <input type="file" name="image_file" accept="image/*" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-navy-50 file:text-navy-900 hover:file:bg-navy-100 cursor-pointer">
          </div>
          <div>
            <label for="external_url" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Atau URL Gambar Eksternal</label>
            <input type="url" id="external_url" name="external_url" placeholder="https://..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="button_text" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Teks Tombol CTA</label>
            <input type="text" id="button_text" name="button_text" value="Pelajari Selengkapnya" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
          </div>
          <div>
            <label for="button_url" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Tautan Tujuan Tombol</label>
            <input type="text" id="button_url" name="button_url" value="/profil" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
          </div>
          <div>
            <label for="order_index" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Urutan Tampil</label>
            <input type="number" id="order_index" name="order_index" value="1" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="pt-2">
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider shadow transition">
            <i class="fa-solid fa-plus mr-1"></i> Tambahkan Banner Slider
          </button>
        </div>
      </form>
    </div>

    <!-- Daftar Banner Saat Ini -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm space-y-4">
      <h3 class="font-bold text-navy-900 text-sm pb-3 border-b border-slate-100 flex items-center justify-between">
        <span><i class="fa-solid fa-sliders text-gold-500 mr-2"></i>Banner Aktif Saat Ini</span>
        <span class="text-xs text-slate-400 font-semibold"><%= sliders.length %> Slider</span>
      </h3>

      <div class="space-y-4">
        <% if (sliders && sliders.length > 0) { %>
          <% sliders.forEach(slider => { %>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
              <div class="flex items-center gap-4 w-full sm:w-auto">
                <div class="w-24 h-16 rounded-xl overflow-hidden bg-slate-200 flex-shrink-0">
                  <img src="<%= slider.image_url %>" alt="" class="w-full h-full object-cover">
                </div>
                <div>
                  <h4 class="font-bold text-navy-900 text-sm"><%= slider.title %></h4>
                  <p class="text-xs text-slate-500 line-clamp-1 mt-0.5"><%= slider.subtitle %></p>
                  <div class="text-[11px] text-gold-600 mt-1 font-semibold">
                    Tombol: <%= slider.button_text %> &rarr; <span class="font-mono text-slate-400"><%= slider.button_url %></span>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                <span class="text-xs font-bold text-slate-400">Urutan: #<%= slider.order_index %></span>
                <form action="/admin/sliders/<%= slider.id %>/delete" method="POST" onsubmit="return confirm('Hapus banner slider ini?')">
                  <button type="submit" class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition" title="Hapus">
                    <i class="fa-solid fa-trash-can text-sm"></i>
                  </button>
                </form>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

  </main>
</div>

<%- include('../../partials/admin-footer') %>
