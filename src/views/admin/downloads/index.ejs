<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <%- include('../../partials/alerts') %>

    <div>
      <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Manajemen Dokumen Unduhan</h1>
      <p class="text-xs text-slate-500 mt-0.5">Kelola formulir, silabus, juknis PPDB, dan kalender pendidikan untuk publik</p>
    </div>

    <!-- Form Upload Dokumen Baru -->
    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <h3 class="font-bold text-navy-900 text-sm mb-4 pb-3 border-b border-slate-100 flex items-center gap-2">
        <i class="fa-solid fa-cloud-arrow-up text-gold-500"></i> Unggah Dokumen Baru
      </h3>

      <form action="/admin/downloads" method="POST" enctype="multipart/form-data" class="space-y-4 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="title" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Judul Dokumen <span class="text-rose-500">*</span></label>
            <input type="text" id="title" name="title" required placeholder="Contoh: Formulir Pendaftaran Ulang PPDB 2026" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
          </div>
          <div>
            <label for="category" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Kategori Dokumen</label>
            <select id="category" name="category" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
              <option value="Formulir">Formulir Administrasi</option>
              <option value="Kurikulum">Kurikulum & Silabus</option>
              <option value="Panduan">Panduan & Tata Tertib</option>
              <option value="Kalender Pendidikan">Kalender Pendidikan</option>
              <option value="Lainnya">Dokumen Lainnya</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Pilih File Dokumen (PDF, DOCX, XLSX, PPT) <span class="text-rose-500">*</span></label>
          <input type="file" name="document_file" required accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-navy-50 file:text-navy-900 hover:file:bg-navy-100 cursor-pointer">
          <p class="text-[10px] text-slate-400 mt-1">Ukuran berkas maksimal 20 MB.</p>
        </div>

        <div class="pt-2">
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider shadow transition">
            <i class="fa-solid fa-cloud-arrow-up mr-1"></i> Unggah Dokumen
          </button>
        </div>
      </form>
    </div>

    <!-- Table of existing downloads -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
              <th class="py-4 px-6">Nama Dokumen</th>
              <th class="py-4 px-6">Kategori</th>
              <th class="py-4 px-6">Format & Ukuran</th>
              <th class="py-4 px-6 text-center">Jumlah Unduhan</th>
              <th class="py-4 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (downloads && downloads.length > 0) { %>
              <% downloads.forEach(doc => { %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-4 px-6 font-bold text-navy-900">
                    <div class="flex items-center gap-2">
                      <i class="fa-solid fa-file-lines text-gold-500 text-sm"></i>
                      <span><%= doc.title %></span>
                    </div>
                    <div class="text-[10px] text-slate-400 font-mono mt-0.5"><%= doc.file_name %></div>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-navy-50 text-navy-800">
                      <%= doc.category %>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-600 font-semibold">
                    <%= doc.file_type %> &bull; <%= doc.file_size %>
                  </td>
                  <td class="py-4 px-6 text-center text-slate-500 font-bold">
                    <i class="fa-solid fa-download text-gold-500 mr-1"></i> <%= doc.download_count %>
                  </td>
                  <td class="py-4 px-6 text-right space-x-1">
                    <a href="<%= doc.file_path %>" target="_blank" class="p-2 rounded-xl text-slate-400 hover:text-navy-900 hover:bg-slate-100 inline-block transition" title="Unduh File">
                      <i class="fa-solid fa-download text-xs"></i>
                    </a>
                    <form action="/admin/downloads/<%= doc.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Hapus file dokumen ini?')">
                      <button type="submit" class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 inline-block transition" title="Hapus">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-12 text-slate-400 text-xs">
                  Belum ada dokumen unduhan yang diunggah.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<%- include('../../partials/admin-footer') %>
