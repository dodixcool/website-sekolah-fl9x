<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Edit Guru / Tenaga Kependidikan</h1>
        <p class="text-xs text-slate-500 mt-0.5">Perbarui biodata "<%= teacher.name %>"</p>
      </div>
      <a href="/admin/teachers" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold hover:bg-slate-50 transition">
        <i class="fa-solid fa-arrow-left"></i> Kembali
      </a>
    </div>

    <div class="max-w-3xl bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <form action="/admin/teachers/<%= teacher.id %>" method="POST" enctype="multipart/form-data" class="space-y-4 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Nama Lengkap & Gelar <span class="text-rose-500">*</span></label>
            <input type="text" id="name" name="name" required value="<%= teacher.name %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
          </div>
          <div>
            <label for="nip" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">NIP (Opsional)</label>
            <input type="text" id="nip" name="nip" value="<%= teacher.nip || '' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="role_type" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Kategori Peran</label>
            <select id="role_type" name="role_type" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
              <option value="guru" <%= teacher.role_type === 'guru' ? 'selected' : '' %>>Guru Mata Pelajaran</option>
              <option value="kepala_sekolah" <%= teacher.role_type === 'kepala_sekolah' ? 'selected' : '' %>>Kepala Sekolah</option>
              <option value="staff" <%= teacher.role_type === 'staff' ? 'selected' : '' %>>Tenaga Kependidikan / Tata Usaha</option>
            </select>
          </div>
          <div>
            <label for="position" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Jabatan</label>
            <input type="text" id="position" name="position" value="<%= teacher.position || '' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
          <div>
            <label for="subject" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Mata Pelajaran Diampu</label>
            <input type="text" id="subject" name="subject" value="<%= teacher.subject || '' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="education" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Riwayat Pendidikan Terakhir</label>
            <input type="text" id="education" name="education" value="<%= teacher.education || '' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
          <div>
            <label for="email" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Email (Opsional)</label>
            <input type="email" id="email" name="email" value="<%= teacher.email || '' %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Foto Profil</label>
            <% if (teacher.photo) { %>
              <div class="mb-2 w-12 h-12 rounded-full overflow-hidden bg-slate-100">
                <img src="<%= teacher.photo %>" alt="" class="w-full h-full object-cover">
              </div>
            <% } %>
            <input type="file" name="photo" accept="image/*" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-navy-50 file:text-navy-900 hover:file:bg-navy-100 cursor-pointer">
            <p class="text-[10px] text-slate-400 mt-1">Biarkan kosong jika tidak ingin mengganti foto.</p>
          </div>
          <div>
            <label for="order_index" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Urutan Tampil (Order)</label>
            <input type="number" id="order_index" name="order_index" value="<%= teacher.order_index %>" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div class="flex items-center gap-2 pt-1">
          <input type="checkbox" id="is_active" name="is_active" value="1" <%= teacher.is_active ? 'checked' : '' %> class="w-4 h-4 rounded text-gold-600 focus:ring-gold-500 border-slate-300">
          <label for="is_active" class="font-semibold text-slate-700">Status Aktif Bekerja</label>
        </div>

        <div class="pt-3">
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider shadow transition">
            <i class="fa-solid fa-floppy-disk mr-1"></i> Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../../partials/admin-footer') %>
