<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <%- include('../../partials/alerts') %>

    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Manajemen Ekstrakurikuler</h1>
        <p class="text-xs text-slate-500 mt-0.5">Kelola pilihan kegiatan ekstrakurikuler, pembina, jadwal, dan lokasi latihan</p>
      </div>
      <a href="/admin/extracurriculars/create" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-navy-900 hover:bg-navy-800 text-white font-bold text-xs shadow transition">
        <i class="fa-solid fa-plus text-gold-400"></i> Tambah Ekstrakurikuler
      </a>
    </div>

    <!-- Table of extracurriculars -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
              <th class="py-4 px-6 w-16 text-center">Foto</th>
              <th class="py-4 px-6">Nama Ekstrakurikuler</th>
              <th class="py-4 px-6">Kategori</th>
              <th class="py-4 px-6">Pembina</th>
              <th class="py-4 px-6">Jadwal Latihan</th>
              <th class="py-4 px-6">Lokasi</th>
              <th class="py-4 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (extracurriculars && extracurriculars.length > 0) { %>
              <% extracurriculars.forEach(extra => { %>
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="py-4 px-6 text-center">
                    <img src="<%= extra.photo || '/images/default-news.jpg' %>" alt="" class="w-12 h-12 rounded-xl object-cover bg-slate-100 mx-auto">
                  </td>
                  <td class="py-4 px-6">
                    <div class="font-bold text-navy-900 text-sm"><%= extra.name %></div>
                    <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5"><%= extra.description %></div>
                  </td>
                  <td class="py-4 px-6">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[10px] font-bold bg-navy-50 text-navy-800">
                      <%= extra.category %>
                    </span>
                  </td>
                  <td class="py-4 px-6 text-slate-600 font-semibold">
                    <%= extra.mentor || '-' %>
                  </td>
                  <td class="py-4 px-6 text-slate-600">
                    <i class="fa-regular fa-clock text-gold-500 mr-1"></i> <%= extra.schedule || '-' %>
                  </td>
                  <td class="py-4 px-6 text-slate-500">
                    <%= extra.location || '-' %>
                  </td>
                  <td class="py-4 px-6 text-right space-x-1">
                    <a href="/admin/extracurriculars/<%= extra.id %>/edit" class="p-2 rounded-xl text-slate-400 hover:text-navy-900 hover:bg-slate-100 inline-block transition" title="Edit">
                      <i class="fa-solid fa-pen-to-square text-xs"></i>
                    </a>
                    <form action="/admin/extracurriculars/<%= extra.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Hapus ekstrakurikuler ini?')">
                      <button type="submit" class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 inline-block transition" title="Hapus">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-12 text-slate-400 text-xs">
                  Belum ada ekstrakurikuler yang dicatat.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<%- include('../../partials/admin-footer') %>
