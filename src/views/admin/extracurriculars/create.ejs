<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Tambah Ekstrakurikuler Baru</h1>
        <p class="text-xs text-slate-500 mt-0.5">Daftarkan kegiatan minat bakat siswa</p>
      </div>
      <a href="/admin/extracurriculars" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold hover:bg-slate-50 transition">
        <i class="fa-solid fa-arrow-left"></i> Kembali
      </a>
    </div>

    <div class="max-w-3xl bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/80 shadow-sm">
      <form action="/admin/extracurriculars" method="POST" enctype="multipart/form-data" class="space-y-4 text-xs">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Nama Ekstrakurikuler <span class="text-rose-500">*</span></label>
            <input type="text" id="name" name="name" required placeholder="Contoh: Tari Tradisi Bali & Sekaa Gong" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs font-semibold">
          </div>
          <div>
            <label for="category" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Kategori Bidang</label>
            <select id="category" name="category" class="w-full px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
              <option value="Seni & Budaya Bali">Seni & Budaya Bali</option>
              <option value="Sains & Teknologi">Sains & Teknologi</option>
              <option value="Olahraga Prestasi">Olahraga Prestasi</option>
              <option value="Kepanduan & Karakter">Kepanduan & Karakter</option>
              <option value="Kemanusiaan & Kesehatan">Kemanusiaan & Kesehatan</option>
              <option value="Bahasa & Komunikasi">Bahasa & Komunikasi</option>
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label for="mentor" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Guru Pembina / Pelatih</label>
            <input type="text" id="mentor" name="mentor" placeholder="Nama pembina..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
          <div>
            <label for="schedule" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Jadwal Latihan</label>
            <input type="text" id="schedule" name="schedule" placeholder="Contoh: Senin & Kamis 15.30 WITA" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
          <div>
            <label for="location" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Lokasi / Ruang Latihan</label>
            <input type="text" id="location" name="location" placeholder="Contoh: Bale Widya Sabha / Lapangan" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs">
          </div>
        </div>

        <div>
          <label class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Foto Dokumentasi Kegiatan</label>
          <input type="file" name="photo" accept="image/*" class="w-full text-xs text-slate-500 file:mr-3 file:py-2 file:px-3 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-navy-50 file:text-navy-900 hover:file:bg-navy-100 cursor-pointer">
        </div>

        <div>
          <label for="description" class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Deskripsi & Visi Ekstrakurikuler</label>
          <textarea id="description" name="description" rows="3" placeholder="Informasi singkat kegiatan, target kompetisi..." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-navy-900 text-xs"></textarea>
        </div>

        <div class="pt-3">
          <button type="submit" class="px-6 py-2.5 rounded-xl bg-gold-500 hover:bg-gold-600 text-white font-bold text-xs uppercase tracking-wider shadow transition">
            <i class="fa-solid fa-plus mr-1"></i> Simpan Ekstrakurikuler
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<%- include('../../partials/admin-footer') %>
