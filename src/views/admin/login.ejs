<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Login Administrator' %></title>
  
  <link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/2997/2997295.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            navy: {
              800: '#1b3254',
              900: '#0B2545',
              950: '#07162b',
            },
            gold: {
              400: '#eeb85f',
              500: '#e59d33',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-gold-500 selection:text-white">

  <!-- Background decorative elements -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-navy-800/40 rounded-full blur-3xl"></div>
  </div>

  <div class="relative w-full max-w-md">
    
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <div class="w-20 h-20 rounded-2xl bg-white p-2 mx-auto flex items-center justify-center shadow-xl ring-2 ring-gold-400/50 mb-3 overflow-hidden">
        <% if (school.logo_url) { %>
          <img src="<%= school.logo_url %>" alt="Logo" class="w-full h-full object-contain">
        <% } else { %>
          <i class="fa-solid fa-graduation-cap text-3xl text-navy-900"></i>
        <% } %>
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white"><%= school.school_name || 'SMA NEGERI 12 DENPASAR' %></h1>
      <p class="text-xs text-slate-400 font-medium tracking-wide mt-1 uppercase">NPSN <%= school.school_npsn || '69992012' %> &bull; Portal Administrator</p>
    </div>

    <!-- Alert Messages -->
    <% if (errorMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-rose-400 text-base"></i>
        <span><%= errorMsg %></span>
      </div>
    <% } %>

    <% if (successMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>

    <!-- Form Box -->
    <div class="bg-slate-800/90 backdrop-blur-xl rounded-3xl p-8 border border-slate-700 shadow-2xl">
      <form action="/auth/login" method="POST" class="space-y-5">
        <div>
          <label for="username" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Username atau Email</label>
          <div class="relative">
            <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="username" name="username" required autofocus placeholder="Masukkan username atau email" class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="password" class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Kata Sandi (Password)</label>
            <a href="/auth/forgot-password" class="text-[11px] text-gold-400 hover:text-gold-300 font-semibold transition hover:underline">Lupa kata sandi?</a>
          </div>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="password" id="password" name="password" required placeholder="Masukkan kata sandi" class="w-full pl-10 pr-10 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
            <button type="button" onclick="togglePass()" class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white" aria-label="Toggle password">
              <i id="passIcon" class="fa-solid fa-eye text-xs"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-white font-bold text-xs tracking-wider uppercase shadow-lg shadow-gold-500/20 transition transform hover:-translate-y-0.5">
          <i class="fa-solid fa-right-to-bracket mr-1.5"></i> Masuk ke Panel Admin
        </button>
      </form>
    </div>

    <!-- Back to public site -->
    <div class="text-center mt-6">
      <a href="/" class="text-xs text-slate-400 hover:text-gold-400 transition inline-flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-left"></i> Kembali ke Halaman Utama Sekolah
      </a>
    </div>

  </div>

  <script>
    function togglePass() {
      const p = document.getElementById('password');
      const icon = document.getElementById('passIcon');
      if (p.type === 'password') {
        p.type = 'text';
        icon.classList.remove('fa-eye');
        icon.classList.add('fa-eye-slash');
      } else {
        p.type = 'password';
        icon.classList.remove('fa-eye-slash');
        icon.classList.add('fa-eye');
      }
    }
  </script>
</body>
</html>
