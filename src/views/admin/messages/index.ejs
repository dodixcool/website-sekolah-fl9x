<%- include('../../partials/admin-header') %>
<%- include('../../partials/admin-sidebar') %>

<div class="flex-grow flex flex-col h-screen overflow-hidden">
  <%- include('../../partials/admin-navbar') %>

  <main class="flex-grow overflow-y-auto p-6 sm:p-8 bg-slate-100 space-y-6">
    <%- include('../../partials/alerts') %>

    <div>
      <h1 class="text-xl font-extrabold text-navy-900 tracking-tight">Kotak Masuk Buku Tamu & Aspirasi</h1>
      <p class="text-xs text-slate-500 mt-0.5">Pesan, pertanyaan, dan kritik saran dari orang tua, siswa, dan masyarakat umum</p>
    </div>

    <!-- Table of messages -->
    <div class="bg-white rounded-3xl border border-slate-200/80 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
              <th class="py-4 px-6 w-12 text-center">Status</th>
              <th class="py-4 px-6">Pengirim & Kontak</th>
              <th class="py-4 px-6">Subjek & Cuplikan Pesan</th>
              <th class="py-4 px-6">Tanggal Kirim</th>
              <th class="py-4 px-6 text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% if (messages && messages.length > 0) { %>
              <% messages.forEach(msg => { %>
                <tr class="hover:bg-slate-50/80 transition <%= msg.is_read ? 'opacity-75' : 'bg-gold-50/20' %>">
                  <td class="py-4 px-6 text-center">
                    <% if (msg.is_read) { %>
                      <span class="w-2.5 h-2.5 rounded-full bg-slate-300 inline-block" title="Sudah dibaca"></span>
                    <% } else { %>
                      <span class="w-2.5 h-2.5 rounded-full bg-gold-500 inline-block" title="Belum dibaca"></span>
                    <% } %>
                  </td>
                  <td class="py-4 px-6">
                    <div class="font-bold text-navy-900 text-sm"><%= msg.name %></div>
                    <div class="text-[11px] text-slate-500"><%= msg.email %></div>
                    <% if (msg.phone) { %>
                      <div class="text-[10px] text-slate-400 font-mono"><%= msg.phone %></div>
                    <% } %>
                  </td>
                  <td class="py-4 px-6">
                    <div class="font-bold text-navy-900"><%= msg.subject %></div>
                    <div class="text-[11px] text-slate-500 line-clamp-1 mt-0.5"><%= msg.message %></div>
                  </td>
                  <td class="py-4 px-6 text-slate-500 font-medium">
                    <%= formatDate(msg.created_at) %>
                  </td>
                  <td class="py-4 px-6 text-right space-x-1">
                    <a href="/admin/messages/<%= msg.id %>" class="px-3 py-1.5 rounded-xl bg-navy-900 text-white font-semibold text-xs hover:bg-gold-500 transition inline-block">
                      <i class="fa-solid fa-envelope-open mr-1"></i> Buka Pesan
                    </a>
                    <form action="/admin/messages/<%= msg.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Hapus pesan ini?')">
                      <button type="submit" class="p-2 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 inline-block transition" title="Hapus">
                        <i class="fa-solid fa-trash-can text-xs"></i>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-12 text-slate-400 text-xs">
                  Tidak ada pesan masuk.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

  </main>
</div>

<%- include('../../partials/admin-footer') %>
