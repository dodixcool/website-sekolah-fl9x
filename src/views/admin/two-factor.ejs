<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Verifikasi Dua Faktor' %></title>

  <link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/2997/2997295.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            navy: { 800: '#1b3254', 900: '#0B2545', 950: '#07162b' },
            gold: { 400: '#eeb85f', 500: '#e59d33', 600: '#d97706' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-gold-500 selection:text-white">

  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-navy-800/40 rounded-full blur-3xl"></div>
  </div>

  <div class="relative w-full max-w-md">

    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-gold-500 flex items-center justify-center shadow-xl ring-2 ring-gold-400/50 mb-3">
        <i class="fa-solid fa-mobile-screen-button text-2xl text-white"></i>
      </div>
      <h1 class="text-xl sm:text-2xl font-black tracking-tight text-white">Verifikasi Dua Faktor</h1>
      <p class="text-xs text-slate-400 font-medium tracking-wide mt-1">Langkah keamanan terakhir sebelum masuk</p>
    </div>

    <% if (errorMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-rose-400 text-base"></i>
        <span><%= errorMsg %></span>
      </div>
    <% } %>

    <% if (successMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>

    <div class="bg-slate-800/90 backdrop-blur-xl rounded-3xl p-8 border border-slate-700 shadow-2xl">
      <p class="text-xs text-slate-300 leading-relaxed mb-5">
        Buka aplikasi <strong class="text-gold-400">Google Authenticator</strong>, <strong class="text-gold-400">Microsoft Authenticator</strong>,
        atau aplikasi TOTP lainnya, lalu masukkan kode 6 digit untuk akun sekolah ini.
      </p>

      <form action="/auth/two-factor" method="POST" class="space-y-5">
        <div>
          <label for="code" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Kode Verifikasi</label>
          <div class="relative">
            <i class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="text" id="code" name="code" required autofocus inputmode="numeric" autocomplete="one-time-code"
                   maxlength="9" placeholder="123 456 atau kode cadangan"
                   class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-sm tracking-[0.3em] text-center font-mono text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-white font-bold text-xs tracking-wider uppercase shadow-lg shadow-gold-500/20 transition transform hover:-translate-y-0.5">
          <i class="fa-solid fa-right-to-bracket mr-1.5"></i> Verifikasi & Masuk
        </button>
      </form>

      <div class="mt-4 p-3 rounded-xl bg-slate-900/60 border border-slate-700/70 text-[11px] text-slate-400 leading-relaxed">
        <i class="fa-solid fa-circle-info text-slate-500 mr-1"></i>
        Kehilangan perangkat? Gunakan salah satu <strong class="text-slate-300">kode cadangan</strong> yang Anda simpan saat mengaktifkan 2FA.
      </div>
    </div>

    <div class="text-center mt-6">
      <a href="/auth/logout" class="text-xs text-slate-400 hover:text-gold-400 transition inline-flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-left"></i> Batal dan kembali ke halaman login
      </a>
    </div>

  </div>

</body>
</html>
