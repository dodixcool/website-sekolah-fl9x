<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Ganti Kata Sandi' %></title>

  <link rel="icon" type="image/png" href="https://cdn-icons-png.flaticon.com/512/2997/2997295.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            navy: { 800: '#1b3254', 900: '#0B2545', 950: '#07162b' },
            gold: { 400: '#eeb85f', 500: '#e59d33', 600: '#d97706' }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-gold-500 selection:text-white">

  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-navy-800/40 rounded-full blur-3xl"></div>
  </div>

  <div class="relative w-full max-w-md">

    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-white p-2 mx-auto flex items-center justify-center shadow-xl ring-2 ring-gold-400/50 mb-3 overflow-hidden">
        <% if (school.logo_url) { %>
          <img src="<%= school.logo_url %>" alt="Logo" class="w-full h-full object-contain">
        <% } else { %>
          <i class="fa-solid fa-graduation-cap text-3xl text-navy-900"></i>
        <% } %>
      </div>
      <h1 class="text-xl sm:text-2xl font-black tracking-tight text-white"><%= school.school_name || 'SMA NEGERI 12 DENPASAR' %></h1>
      <p class="text-xs text-slate-400 font-medium tracking-wide mt-1 uppercase">Keamanan Akun Administrator</p>
    </div>

    <% if (forced) { %>
      <div class="mb-4 p-4 rounded-2xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs flex items-start gap-3">
        <i class="fa-solid fa-shield-halved text-amber-400 text-base mt-0.5"></i>
        <span>Akun Anda masih memakai kata sandi default. Ganti kata sandi terlebih dahulu sebelum mengakses panel admin.</span>
      </div>
    <% } %>

    <% if (errorMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-rose-400 text-base"></i>
        <span><%= errorMsg %></span>
      </div>
    <% } %>

    <% if (successMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>

    <div class="bg-slate-800/90 backdrop-blur-xl rounded-3xl p-8 border border-slate-700 shadow-2xl">
      <form action="/auth/change-password" method="POST" class="space-y-5">

        <div>
          <label for="current_password" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Kata Sandi Saat Ini</label>
          <div class="relative">
            <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="password" id="current_password" name="current_password" required autofocus placeholder="Masukkan kata sandi sekarang" class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
          </div>
        </div>

        <div>
          <label for="new_password" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Kata Sandi Baru</label>
          <div class="relative">
            <i class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="password" id="new_password" name="new_password" required minlength="8" placeholder="Minimal 8 karakter, huruf + angka" class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
          </div>
          <p class="text-[11px] text-slate-400 mt-1.5">Minimal 8 karakter, harus memuat huruf dan angka, dan tidak boleh kata sandi yang mudah ditebak.</p>
        </div>

        <div>
          <label for="confirm_password" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Ulangi Kata Sandi Baru</label>
          <div class="relative">
            <i class="fa-solid fa-check-double absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
            <input type="password" id="confirm_password" name="confirm_password" required minlength="8" placeholder="Ketik ulang kata sandi baru" class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
          </div>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-white font-bold text-xs tracking-wider uppercase shadow-lg shadow-gold-500/20 transition transform hover:-translate-y-0.5">
          <i class="fa-solid fa-shield-halved mr-1.5"></i> Simpan Kata Sandi Baru
        </button>
      </form>
    </div>

    <div class="text-center mt-6">
      <a href="/auth/logout" class="text-xs text-slate-400 hover:text-gold-400 transition inline-flex items-center gap-1.5">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Keluar dari akun
      </a>
    </div>

  </div>

</body>
</html>
