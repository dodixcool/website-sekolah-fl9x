<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Lupa Kata Sandi - Panel Admin' %></title>
  
  <link rel="icon" type="image/svg+xml" href="<%= school.logo_url || '/images/logo-sekolah.svg' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            navy: {
              800: '#1b3254',
              900: '#0B2545',
              950: '#07162b',
            },
            gold: {
              400: '#eeb85f',
              500: '#e59d33',
              600: '#d97706',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex items-center justify-center p-4 antialiased selection:bg-gold-500 selection:text-white">

  <!-- Background decorative elements -->
  <div class="fixed inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-96 h-96 bg-gold-500/10 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-navy-800/40 rounded-full blur-3xl"></div>
  </div>

  <div class="relative w-full max-w-md">
    
    <!-- Logo & Header -->
    <div class="text-center mb-8">
      <div class="w-16 h-16 rounded-2xl bg-white p-2 mx-auto flex items-center justify-center shadow-xl ring-2 ring-gold-400/50 mb-3 overflow-hidden">
        <% if (school.logo_url) { %>
          <img src="<%= school.logo_url %>" alt="Logo" class="w-full h-full object-contain">
        <% } else { %>
          <i class="fa-solid fa-graduation-cap text-3xl text-navy-900"></i>
        <% } %>
      </div>
      <h1 class="text-xl sm:text-2xl font-black tracking-tight text-white"><%= school.school_name || 'SMA NEGERI 12 DENPASAR' %></h1>
      <p class="text-xs text-slate-400 font-medium tracking-wide mt-1 uppercase">Pemulihan Akun Administrator</p>
    </div>

    <!-- Alert Messages -->
    <% if (errorMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-triangle-exclamation text-rose-400 text-base"></i>
        <span><%= errorMsg %></span>
      </div>
    <% } %>

    <% if (successMsg) { %>
      <div class="mb-4 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center gap-3">
        <i class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
        <span><%= successMsg %></span>
      </div>
    <% } %>

    <!-- Card Container -->
    <div class="bg-slate-800/90 backdrop-blur-xl rounded-3xl p-8 border border-slate-700 shadow-2xl space-y-6">
      
      <% if (typeof resetData !== 'undefined' && resetData) { %>
        <!-- Tahap Konfirmasi Akun Ditemukan -->
        <div class="text-center space-y-4">
          <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-xl mx-auto border border-emerald-500/30">
            <i class="fa-solid fa-check"></i>
          </div>
          <div>
            <h3 class="font-bold text-white text-base">Akun Ditemukan!</h3>
            <p class="text-xs text-slate-300 mt-1">
              Permintaan pemulihan untuk <strong class="text-gold-400"><%= resetData.user.name %></strong> (@<%= resetData.user.username %>) telah disetujui.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-slate-900/70 border border-slate-700 text-left space-y-2 text-xs">
            <div class="text-[11px] text-slate-400 flex justify-between">
              <span>Kode Otorisasi Reset:</span>
              <span class="font-mono font-bold text-gold-400"><%= resetData.tokenCode %></span>
            </div>
            <div class="text-[11px] text-slate-400 flex justify-between">
              <span>Batas Waktu Berlaku:</span>
              <span class="text-slate-300">30 Menit</span>
            </div>
          </div>

          <a href="<%= resetData.resetUrl %>" class="block w-full py-3.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-white font-bold text-xs tracking-wider uppercase shadow-lg shadow-gold-500/20 transition transform hover:-translate-y-0.5 text-center">
            <i class="fa-solid fa-key mr-1.5"></i> Lanjut Buat Kata Sandi Baru
          </a>
        </div>

      <% } else { %>
        
        <!-- Formulir Permintaan Reset -->
        <div class="space-y-2">
          <h2 class="text-base font-bold text-white">Reset Kata Sandi Anda</h2>
          <p class="text-xs text-slate-400 leading-relaxed">
            Masukkan username atau email terdaftar, atau gunakan Kunci Pemulihan Darurat Sekolah yang hanya diketahui operator server.
          </p>
        </div>

        <form action="/auth/forgot-password" method="POST" class="space-y-4">
          <div>
            <label for="identity" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider">Username atau Email Admin</label>
            <div class="relative">
              <i class="fa-solid fa-user absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
              <input type="text" id="identity" name="identity" autofocus placeholder="Contoh: admin atau admin@sman12denpasar.sch.id" class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition">
            </div>
          </div>

          <div class="pt-2">
            <div class="relative flex py-2 items-center">
              <div class="flex-grow border-t border-slate-700"></div>
              <span class="flex-shrink mx-3 text-[10px] text-slate-400 uppercase font-semibold">Atau Opsi Darurat</span>
              <div class="flex-grow border-t border-slate-700"></div>
            </div>
          </div>

          <div>
            <label for="recovery_key" class="block text-xs font-bold text-slate-300 mb-1.5 uppercase tracking-wider flex items-center justify-between">
              <span>Kunci Pemulihan Darurat (Master Key)</span>
              <span class="text-[10px] text-gold-400 font-normal">Rahasia operator server</span>
            </label>
            <div class="relative">
              <i class="fa-solid fa-shield-halved absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
              <input type="password" id="recovery_key" name="recovery_key" placeholder="Masukkan Kunci Pemulihan Darurat" class="w-full pl-10 pr-4 py-3 bg-slate-900/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-gold-500 focus:border-transparent transition font-mono">
            </div>
          </div>

          <button type="submit" class="w-full py-3.5 rounded-xl bg-gradient-to-r from-gold-500 to-gold-600 hover:from-gold-600 hover:to-gold-700 text-white font-bold text-xs tracking-wider uppercase shadow-lg shadow-gold-500/20 transition transform hover:-translate-y-0.5">
            <i class="fa-solid fa-arrow-right mr-1.5"></i> Verifikasi & Lanjutkan
          </button>
        </form>

      <% } %>

      <!-- Tombol Kembali -->
      <div class="pt-4 border-t border-slate-700/80 text-center">
        <a href="/auth/login" class="text-xs text-slate-400 hover:text-gold-400 transition inline-flex items-center gap-1.5 font-medium">
          <i class="fa-solid fa-arrow-left"></i> Kembali ke Halaman Login
        </a>
      </div>

    </div>

  </div>

</body>
</html>
